{
  "name": "customvibe-security",
  "main": "security/index.mjs",
  "compatibility_date": "2026-06-16",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "customvibe-security",
      "database_id": "25fb2dda-2ce9-4f8c-b49d-e6480218a5cf",
      "migrations_dir": "migrations/security"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SITE_LOCKOUT",
      "id": "0fc5a43856944054a39c99fc5a882b42"
    },
    {
      "binding": "ADMIN_LOCKOUT",
      "id": "05f525369d3c42a8a0dcbcc71c8d0471"
    }
  ],
  "account_id": "4f57d4e924674cb87b33d4c884745cf6",
  "r2_buckets": [
    {
      "binding": "ARTWORK",
      "bucket_name": "customvibe-test-artwork"
    }
  ]
}
