{
  "name": "customvibe-admin",
  "main": "admin/worker.mjs",
  "compatibility_date": "2026-06-16",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"directory": "dist/admin", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "404-page"},
  "services": [{"binding": "AUTH", "service": "customvibe-security"}]
}
