{
  "name": "customvibe-admin",
  "main": "admin/worker.mjs",
  "compatibility_date": "2026-06-16",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "dist/admin",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "services": [
    {
      "binding": "AUTH",
      "service": "customvibe-security"
    }
  ],
  "d1_databases": [
    {
      "binding": "CONTENT_DB",
      "database_name": "customvibe-content",
      "database_id": "8883d934-89f5-4da0-97a1-f7624d008a33",
      "migrations_dir": "migrations/content"
    }
  ],
  "routes": [
    {
      "pattern": "admin.customvibe.co.za",
      "custom_domain": true
    }
  ],
  "account_id": "4f57d4e924674cb87b33d4c884745cf6"
}
