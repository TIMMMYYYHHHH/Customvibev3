{
  "name": "CustomVibe Order Confirmation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "customvibe-order",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-node",
      "name": "Order Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "customvibe-order"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.headers['x-order-secret'] }}",
              "rightValue": "REPLACE_WITH_YOUR_SHARED_SECRET",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-secret",
      "name": "Valid Secret?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "phoneNumberId": "REPLACE_WITH_PHONE_NUMBER_ID",
        "recipientPhoneNumber": "={{ $json.body.customerPhone }}",
        "messageType": "template",
        "template": "order_confirmation|en",
        "components": {
          "component": [
            {
              "type": "body",
              "bodyParameters": {
                "parameter": [
                  { "type": "text", "text": "={{ $json.body.customerName }}" },
                  { "type": "text", "text": "={{ $json.body.orderRef }}" },
                  { "type": "text", "text": "={{ $json.body.totalQty }}" },
                  { "type": "text", "text": "={{ $json.body.total }}" }
                ]
              }
            }
          ]
        }
      },
      "id": "whatsapp-customer",
      "name": "WhatsApp Customer",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [460, -100],
      "credentials": {}
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "phoneNumberId": "REPLACE_WITH_PHONE_NUMBER_ID",
        "recipientPhoneNumber": "27674067059",
        "messageType": "text",
        "textBody": "=🧲 NEW ORDER {{ $json.body.orderRef }}\n\nName: {{ $json.body.customerName }}\nPhone: {{ $json.body.customerPhone }}\nEmail: {{ $json.body.customerEmail }}\nPUDO: {{ $json.body.pudoLocation }}\nNotes: {{ $json.body.notes || '-' }}\n\nMagnets ({{ $json.body.totalQty }}):\n{{ $json.body.designs.map((d, i) => `#${i + 1} ${d.name} x${d.quantity}`).join('\\n') }}\n\nTotal: R{{ $json.body.total }} (EFT, awaiting payment)"
      },
      "id": "whatsapp-owner",
      "name": "WhatsApp Owner",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [460, 100],
      "credentials": {}
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"ok\": true } }}",
        "options": {}
      },
      "id": "respond-ok",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [700, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"ok\": false, \"error\": \"unauthorized\" } }}",
        "options": { "responseCode": 401 }
      },
      "id": "respond-unauthorized",
      "name": "Respond Unauthorized",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [460, 260]
    }
  ],
  "connections": {
    "Order Webhook": { "main": [[{ "node": "Valid Secret?", "type": "main", "index": 0 }]] },
    "Valid Secret?": {
      "main": [
        [
          { "node": "WhatsApp Customer", "type": "main", "index": 0 },
          { "node": "WhatsApp Owner", "type": "main", "index": 0 }
        ],
        [{ "node": "Respond Unauthorized", "type": "main", "index": 0 }]
      ]
    },
    "WhatsApp Customer": { "main": [[{ "node": "Respond OK", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
