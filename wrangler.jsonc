{
  "name": "customvibe-business",
  "compatibility_date": "2026-06-16",
  "pages_build_output_dir": "dist/client",
  "vars": {
    "SITE_GATE_ENABLED": "true",
    "LOCKER_LOOKUP_ENABLED": "false",
    "SUBMISSIONS_ENABLED": "false",
    "ARTWORK_STORAGE_ENABLED": "false",
    "ORDER_RECORDS_ENABLED": "false",
    "MAP_LOOKUP_ENABLED": "false",
    "LOCKER_SHARED_ENABLED": "false"
  },
  "services": [
    {
      "binding": "AUTH",
      "service": "customvibe-security"
    },
    {
      "binding": "CATALOGUE",
      "service": "customvibe-catalogue"
    }
  ],
  "env": {
    "production": {
      "vars": {
        "SITE_GATE_ENABLED": "true",
        "LOCKER_LOOKUP_ENABLED": "true",
        "SUBMISSIONS_ENABLED": "true",
        "ARTWORK_STORAGE_ENABLED": "true",
        "ORDER_RECORDS_ENABLED": "true",
        "MAP_LOOKUP_ENABLED": "true",
        "LOCKER_SHARED_ENABLED": "true"
      },
      "services": [
        {
          "binding": "AUTH",
          "service": "customvibe-security"
        },
        {
          "binding": "CATALOGUE",
          "service": "customvibe-catalogue"
        }
      ]
    },
    "preview": {
      "vars": {
        "SITE_GATE_ENABLED": "true",
        "LOCKER_LOOKUP_ENABLED": "false",
        "SUBMISSIONS_ENABLED": "false",
        "ARTWORK_STORAGE_ENABLED": "false",
        "ORDER_RECORDS_ENABLED": "false",
        "MAP_LOOKUP_ENABLED": "false",
        "LOCKER_SHARED_ENABLED": "false"
      },
      "services": [
        {
          "binding": "AUTH",
          "service": "customvibe-security"
        },
        {
          "binding": "CATALOGUE",
          "service": "customvibe-catalogue"
        }
      ]
    }
  },
  "limits": {
    "cpu_ms": 1000
  }
}
